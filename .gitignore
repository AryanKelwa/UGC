# =============================================================================
# .gitignore — Enterprise LLM Fine-Tuning Pipeline
# Project: LLaMA 3.1 8B SFT on AWS (CodePipeline + SageMaker)
# =============================================================================


# =============================================================================
# 🔐 SECRETS & CREDENTIALS — Never commit these
# =============================================================================
.env
.env.*
.env.local
.env.production
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/


# =============================================================================
# 🐍 PYTHON
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Distribution / packaging
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Testing
.pytest_cache/
htmlcov/
.tox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml

# PyInstaller
*.manifest
*.spec

# Misc Python
*.log
pip-log.txt
pip-delete-this-directory.txt
cython_debug/
__pypackages__/
celerybeat-schedule
celerybeat.pid
*.sage.py


# =============================================================================
# 🤖 ML / LLM ARTIFACTS — Large files, never push to git
# =============================================================================

# Raw and processed training data (can be reproduced from MongoDB)
data/raw/
data/interim/
data/processed/
data/cache/
data/external/
*.jsonl
*.parquet
*.csv
*.tsv

# Model weights and checkpoints (stored in S3)
outputs/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.gguf

# HuggingFace model cache
.cache/huggingface/
*.tokenizer.json

# Experiment tracking
experiments/wandb/
experiments/tensorboard/
experiments/mlflow/
wandb/
mlruns/
lightning_logs/


# =============================================================================
# ☁️ AWS CDK
# =============================================================================

# CDK output (generated at synth time — never push)
cdk.out/

# CDK staging bucket assets (generated)
deploy/cdk.out/

# CDK context (can contain account IDs — keep locally)
# cdk.context.json  ← uncomment if you don't want to share account context

# CDK Python dependencies installed in deploy/
deploy/.venv/
deploy/venv/
deploy/__pycache__/
deploy/**/__pycache__/


# =============================================================================
# 🐳 DOCKER
# =============================================================================
.dockerignore.bak


# =============================================================================
# 📦 LAMBDA — Pip-installed packages (generated by: pip install -t ./lambda_fn/xxx)
# Only handler.py and requirements.txt should be committed.
# =============================================================================

# result_processor lambda — installed packages
deploy/lambda_fn/result_processor/bson/
deploy/lambda_fn/result_processor/pymongo/
deploy/lambda_fn/result_processor/gridfs/
deploy/lambda_fn/result_processor/dns/
deploy/lambda_fn/result_processor/*.dist-info/
deploy/lambda_fn/result_processor/bin/
deploy/lambda_fn/result_processor/__pycache__/

# fine_tune_trigger lambda — installed packages
deploy/lambda_fn/fine_tune_trigger/bson/
deploy/lambda_fn/fine_tune_trigger/pymongo/
deploy/lambda_fn/fine_tune_trigger/gridfs/
deploy/lambda_fn/fine_tune_trigger/dns/
deploy/lambda_fn/fine_tune_trigger/*.dist-info/
deploy/lambda_fn/fine_tune_trigger/bin/
deploy/lambda_fn/fine_tune_trigger/__pycache__/

# inference handler lambda — installed packages (if added later)
deploy/lambda_fn/bson/
deploy/lambda_fn/pymongo/
deploy/lambda_fn/gridfs/
deploy/lambda_fn/dns/
deploy/lambda_fn/__pycache__/

# Catch-all: any future pip packages installed into lambda dirs
# (covers boto3, botocore, urllib3, etc. if pip-installed locally)
deploy/lambda_fn/**/*.dist-info/
deploy/lambda_fn/**/bin/

# Lambda zip bundles (built at deploy time by CDK)
deploy/lambda_fn/*.zip
fine_tune_trigger/


# =============================================================================
# 📓 JUPYTER NOTEBOOKS
# =============================================================================
.ipynb_checkpoints
notebooks/.ipynb_checkpoints/


# =============================================================================
# 🖥️ OS SPECIFIC
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*


# =============================================================================
