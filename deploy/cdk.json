{
  "app": "python app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements*.txt",
      "source.bat",
      "**/__pycache__",
      "**/.mypy_cache",
      "tests"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],

    "// --- LLM Pipeline Configuration ---": "",
    "reviewer_email": "aryan.xalt2@gmail.com",
    "github_owner": "aryankelwa",
    "github_repo": "UGC",
    "github_branch": "main",
    "github_connection_arn": "arn:aws:codestar-connections:ap-southeast-2:711427856574:connection/REPLACE-ME",
    "budget_limit_usd": "50",

    "// --- SageMaker Endpoint ---": "",
    "instance_type": "ml.g4dn.xlarge",
    "endpoint_name": "llama-finetune-async",
    "model_s3_key": "llama-finetune/model.tar.gz"
  }
}
